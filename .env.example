# ---- Required ----
# https://console.anthropic.com  (Settings > API keys)
ANTHROPIC_API_KEY=sk-ant-...
# Login for the web app (user: admin). Pick something strong.
APP_PASSWORD=change-me-please

# ---- HTTPS (needed to record your voice from the phone) ----
# A subdomain whose DNS A record points to your VPS IP
DOMAIN=clips.example.com

# ---- Auto-posting (optional) ----
# https://upload-post.com  -> API key. One Upload-Post profile per ClipForge channel.
# Free plan = 10 uploads/month; you'll want a paid plan once you post daily.
UPLOADPOST_API_KEY=

# ---- Brain ----
CLAUDE_MODEL=claude-sonnet-5-5

# ---- Transcription ----
# local = Whisper on the VPS CPU (free, slow: roughly the video's length on 2 vCPU)
# groq  = Groq cloud Whisper (about 1 min per hour of video, cheap) -> set GROQ_API_KEY
TRANSCRIBE_PROVIDER=local
WHISPER_MODEL=small
GROQ_API_KEY=

# ---- Server sharing (set automatically by install.sh) ----
# APP_PORT=8000
# APP_CPUS=0.75
# APP_MEM=2g
# delete downloaded source videos of finished jobs after N days (clips are kept)
SOURCE_RETENTION_DAYS=3

# ---- Background loops ----
# how often watched sources are checked for new uploads
WATCH_EVERY_HOURS=3
# how often view counts are refreshed (posts are re-checked on a decaying schedule)
STATS_EVERY_MINUTES=60

# ---- Downloads ----
# If YouTube says "Sign in to confirm you're not a bot", export cookies.txt from your
# browser, save it as ./data/cookies.txt and uncomment:
# YTDLP_COOKIES=/data/cookies.txt
MAX_HEIGHT=1080
AUTO_UPDATE_YTDLP=1
